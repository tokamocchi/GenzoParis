{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenzoParis",
  "mainBinaryName": "genzo-paris",
  "version": "0.1.0",
  "identifier": "io.github.tokamocchi.genzoparis",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GenzoParis",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: genzo: http://genzo.localhost",
        "media-src": "genzo: http://genzo.localhost",
        "connect-src": "ipc: http://ipc.localhost genzo: http://genzo.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: genzo: http://genzo.localhost",
        "media-src": "genzo: http://genzo.localhost",
        "connect-src": "ipc: http://ipc.localhost genzo: http://genzo.localhost ws://localhost:5173 http://localhost:5173",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb"],
    "publisher": "GenzoParis",
    "copyright": "GenzoParis contributors. GPL-3.0-or-later",
    "category": "Photography",
    "shortDescription": "写真の現像（RAW 現像・非破壊編集）とカタログ管理",
    "longDescription": "Lightroom Classic 相当の写真現像（RAW 現像・非破壊編集）とカタログ管理を行うデスクトップアプリです。",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
